<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd" creator="Cirkwi"><metadata><name><![CDATA[Ercé près Liffré : Les Rotes des Huguenots]]></name><desc><![CDATA[Ercé Près Liffré est une commune rurale riche d'histoire, située au fond de la vallée de l'Illet et entourée par les forêts de Rennes et de Haute Sève.  Balisage : FFRP rouge et blanc, jaune + Pays de Liffré  Retrouvez ce circuit dans le guide des "Balades en Pays de Rennes" disponible en Offices de Tourisme et dans certaines mairies.]]></desc><author><name><![CDATA[Pays de Rennes]]></name></author><link href="http://fichier0.cirkwi.com/image/photo/circuit/1300x1300/44807/fr/0.jpg"><text><![CDATA[|Mairie Ercé près Liffré]]></text></link><time>2024-12-23T15:57:43Z</time></metadata><wpt lat="48.2559842" lon="-1.5168858"><ele>62</ele><name><![CDATA[Départ place de la mairie]]></name><desc><![CDATA[Du Centre Culturel (ancien relais de diligences) place de la Mairie. Descendre l’avenue de l’Illet jusqu’au pont et continuer la RD92 sur une dizaine de mètres. S’engager à gauche sur le GR 39 (balisage rouge et blanc).]]></desc><link href="http://fichier0.cirkwi.com/image/photo/poi/1300x1300/316775/fr/0.jpg"><text><![CDATA[|Benoit Gendron]]></text></link></wpt><wpt lat="48.2658267" lon="-1.5137744"><ele>96</ele><name><![CDATA[Bon Air]]></name><desc><![CDATA[A une intersection, traverser pour continuer sur la voie goudronnée en face. Passer au lieu dit Bon Air, ancien relais de poste sur la route du Mont-Saint-Michel. Prendre à droite (balisage jaune) à la Croix de chemin Saint-Georges, édifiée au 16ème siècle, sur laquelle figurent 2 masques sculptés.]]></desc></wpt><wpt lat="48.2725539" lon="-1.5124011"><ele>100</ele><name><![CDATA[RD 92]]></name><desc><![CDATA[Traverser la RD92 et prendre en face le chemin en lisière de la forêt de Haute Sève.]]></desc></wpt><wpt lat="48.2738821" lon="-1.5006638"><ele>102</ele><name><![CDATA[Les Jubauderies]]></name><desc><![CDATA[Traverser la route forestière des Jubeauderies et continuer en lisière de forêt. Cette partie est une zone humide (possibilité de passer à l’intérieur de la forêt si impraticable).]]></desc></wpt><wpt lat="48.2736" lon="-1.49255"><ele>102</ele><name><![CDATA[La Moreaugarde]]></name><desc><![CDATA[À environ 750 m, prendre à droite le chemin qui mène au hameau Moreaugarde et suivre la route jusqu’à l’intersection.]]></desc></wpt><wpt lat="48.26666" lon="-1.49813"><ele>87</ele><name><![CDATA[La Lande d'Ouée]]></name><desc><![CDATA[Traverser la route et prendre le chemin en face bordé de ragolles et d’arbres de haute tige. Ce chemin offre un beau panorama sur le paysage bocager, la vallée et le bourg. Suivre le ruisseau de la Lande d’Ouée jusqu'à la route. Prendre à droite ( balisage jaune).]]></desc><link href="http://fichier0.cirkwi.com/image/photo/poi/1300x1300/316781/fr/0.jpg"><text><![CDATA[|Mairie Ercé près Liffré]]></text></link></wpt><wpt lat="48.2596843" lon="-1.5075302"><ele>61</ele><name><![CDATA[Le Bordage]]></name><desc><![CDATA[Passer devant le château du Bordage qui fut un haut lieu du protestantisme de 1563 jusqu’aux abjurations en 1701. Tourner à gauche pour retrouver l’avenue de l’Illet.]]></desc></wpt><trk><trkseg><trkpt lat="48.25598" lon="-1.51689"><ele>61.83</ele></trkpt><trkpt lat="48.25693" lon="-1.51646"><ele>59.47</ele></trkpt><trkpt lat="48.25773" lon="-1.51605"><ele>59.2</ele></trkpt><trkpt lat="48.26057" lon="-1.5147"><ele>55.48</ele></trkpt><trkpt lat="48.26571" lon="-1.51367"><ele>96.36</ele></trkpt><trkpt lat="48.26583" lon="-1.51377"><ele>97.15</ele></trkpt><trkpt lat="48.26774" lon="-1.51504"><ele>104.72</ele></trkpt><trkpt lat="48.27065" lon="-1.51646"><ele>109.02</ele></trkpt><trkpt lat="48.27143" lon="-1.51719"><ele>107.29</ele></trkpt><trkpt lat="48.27245" lon="-1.51255"><ele>97.63</ele></trkpt><trkpt lat="48.27255" lon="-1.5124"><ele>97.64</ele></trkpt><trkpt lat="48.27291" lon="-1.51144"><ele>96.78</ele></trkpt><trkpt lat="48.27317" lon="-1.51066"><ele>94.95</ele></trkpt><trkpt lat="48.27348" lon="-1.51006"><ele>94</ele></trkpt><trkpt lat="48.2736" lon="-1.50942"><ele>94</ele></trkpt><trkpt lat="48.27368" lon="-1.50873"><ele>94</ele></trkpt><trkpt lat="48.27383" lon="-1.50757"><ele>94.17</ele></trkpt><trkpt lat="48.27391" lon="-1.50671"><ele>95.51</ele></trkpt><trkpt lat="48.274" lon="-1.50586"><ele>96.36</ele></trkpt><trkpt lat="48.274" lon="-1.50547"><ele>96.98</ele></trkpt><trkpt lat="48.274" lon="-1.50483"><ele>97.83</ele></trkpt><trkpt lat="48.274" lon="-1.50397"><ele>97.99</ele></trkpt><trkpt lat="48.27394" lon="-1.50311"><ele>97.65</ele></trkpt><trkpt lat="48.27385" lon="-1.50174"><ele>96.26</ele></trkpt><trkpt lat="48.27383" lon="-1.50101"><ele>95.72</ele></trkpt><trkpt lat="48.27388" lon="-1.50066"><ele>95.54</ele></trkpt><trkpt lat="48.274" lon="-1.49981"><ele>95.28</ele></trkpt><trkpt lat="48.27414" lon="-1.4989"><ele>95.67</ele></trkpt><trkpt lat="48.27417" lon="-1.49822"><ele>95.74</ele></trkpt><trkpt lat="48.27417" lon="-1.49745"><ele>95.9</ele></trkpt><trkpt lat="48.274" lon="-1.49654"><ele>96</ele></trkpt><trkpt lat="48.2738" lon="-1.49564"><ele>96</ele></trkpt><trkpt lat="48.27371" lon="-1.49478"><ele>96</ele></trkpt><trkpt lat="48.27371" lon="-1.49388"><ele>95.83</ele></trkpt><trkpt lat="48.2736" lon="-1.49255"><ele>94.99</ele></trkpt><trkpt lat="48.27228" lon="-1.49247"><ele>93.42</ele></trkpt><trkpt lat="48.27197" lon="-1.49328"><ele>93.19</ele></trkpt><trkpt lat="48.2718" lon="-1.49371"><ele>92.65</ele></trkpt><trkpt lat="48.27171" lon="-1.49436"><ele>92.47</ele></trkpt><trkpt lat="48.27163" lon="-1.49478"><ele>91.58</ele></trkpt><trkpt lat="48.27154" lon="-1.49521"><ele>90.63</ele></trkpt><trkpt lat="48.2714" lon="-1.49543"><ele>89.85</ele></trkpt><trkpt lat="48.27097" lon="-1.49611"><ele>86.8</ele></trkpt><trkpt lat="48.27051" lon="-1.49642"><ele>83.29</ele></tr